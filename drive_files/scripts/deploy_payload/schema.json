{
  "version": "1.4",
  "data_dir": "/mnt/d/paper-factor-data/数据仓库/行情数据/日线/全量",
  "import": {
    "dir": "/mnt/d/paper-factor-data/原始数据",
    "script": "scripts/import_new_data.py",
    "note": "本地导入：用户把新增数据放到 /mnt/d/paper-factor-data/原始数据/（日线/、分钟线/、非行情/ 或根目录），运行脚本自动检测格式并导入。"
  },
  "daily": {
    "format": "per_stock_parquet",
    "stock_list_file": "stock_data/daily/stock_list.json",
    "trade_dates_file": "stock_data/daily/trade_dates.json",
    "industry_file": "stock_data/daily/industry.json",
    "columns": {
      "analyst_coverage": {
        "description": "基于市值转换的分析师覆盖度",
        "source": "原始数据导入"
      },
      "EPS_Predict": {
        "description": "基于通联数据的股票股票EPS预测数据（对应最近一个季度财报）",
        "source": "原始数据导入"
      }
    }
  },
  "minute": {
    "format": "per_date_parquet",
    "stock_list_file": "stock_data/minute_by_date/stock_list.json",
    "trade_dates_file": "stock_data/minute_by_date/trade_dates.json",
    "columns": {
      "open": {
        "description": "分钟开盘价",
        "source": "原始数据导入"
      },
      "close": {
        "description": "分钟收盘价",
        "source": "原始数据导入"
      },
      "high": {
        "description": "分钟最高价",
        "source": "原始数据导入"
      },
      "low": {
        "description": "分钟最低价",
        "source": "原始数据导入"
      },
      "volume": {
        "description": "分钟成交量（手）",
        "source": "原始数据导入"
      },
      "factor": {
        "description": "复权因子（close×factor=后复权价）",
        "source": "原始数据导入"
      },
      "return": {
        "description": "分钟收益率（相对昨收）",
        "source": "原始数据导入"
      }
    }
  }
}
